# Neon PostgreSQL — pooled + direct connection
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — secret: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Google OAuth — redirect URI: https://conexory.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago — usar credenciales de producción en Production, de prueba en Preview
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY se expone al cliente a propósito (tokeniza
# la tarjeta ahí mismo, con el SDK de Mercado Pago) — usar la public key de
# prueba/producción que corresponda al MERCADOPAGO_ACCESS_TOKEN del mismo entorno.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Resend
RESEND_API_KEY=""

# Secret para autenticar los Vercel Cron Jobs (openssl rand -hex 32)
CRON_SECRET=""

# Sentry — error tracking (https://sentry.io)
# DSN: Settings → Projects → [project] → Client Keys
SENTRY_DSN=""
# Auth token for source map upload (Sentry → Settings → Auth Tokens → create with project:releases scope)
# Required in CI and Vercel builds; not needed locally
SENTRY_AUTH_TOKEN=""

# Google AI Studio (Gemini Flash, mejora de mensajes con IA) — gratis en aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""
